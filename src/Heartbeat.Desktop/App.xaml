<Application x:Class="Heartbeat.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Heartbeat.Desktop.Converters">
    <!-- Sin StartupUri: la ventana principal se resuelve desde el contenedor de DI en App.OnStartup. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Views/PageTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
