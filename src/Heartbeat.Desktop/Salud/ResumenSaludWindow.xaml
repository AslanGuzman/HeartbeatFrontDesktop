<Window x:Class="Heartbeat.Desktop.Salud.ResumenSaludWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen de salud · Samsung Health"
        Width="900" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        FontFamily="{DynamicResource UiFont}">
    <DockPanel Margin="24">
        <!-- Pie fijo -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Text="Datos de bienestar. No sustituyen el diagnóstico médico." />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Resumen de salud" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="SyncText" Text="Cargando…" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="{DynamicResource BrandRedBrush}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBlock Text="Últimos valores" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <WrapPanel x:Name="CardsPanel" />

                <TextBlock Text="Actividad" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="StepsTodayText" Text="Pasos de hoy: Sin datos" FontSize="15" Margin="0,0,0,8" />
                <DataGrid x:Name="ActivityGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" MinHeight="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="*" />
                        <DataGridTextColumn Header="Pasos" Binding="{Binding Pasos}" Width="*" />
                        <DataGridTextColumn Header="Distancia" Binding="{Binding Distancia}" Width="*" />
                        <DataGridTextColumn Header="Calorías activas" Binding="{Binding CaloriasActivas}" Width="*" />
                        <DataGridTextColumn Header="Minutos activos" Binding="{Binding MinutosActivos}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Última noche" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="SleepText" Text="Sin datos" FontSize="15" TextWrapping="Wrap" />
                <TextBlock x:Name="SleepStagesText" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
