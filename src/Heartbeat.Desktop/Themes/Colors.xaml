<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Paleta de Heartbeat (tema oscuro, pensado para pantallas en cabina con poca luz).

        NR-01: verde / ámbar / rojo significan SIEMPRE normal / watch / critical y no se usan para nada más.
        Por eso la conectividad usa el color de acento y los grises. El estado nunca se comunica solo con color:
        cada chip lleva además su texto (Normal, Vigilancia, Crítico).
    -->

    <!-- Superficies y texto -->
    <Color x:Key="BackgroundColor">#0B1220</Color>
    <Color x:Key="SurfaceColor">#121B2E</Color>
    <Color x:Key="SurfaceRaisedColor">#1A2540</Color>
    <Color x:Key="BorderColor">#2A3757</Color>
    <Color x:Key="TextPrimaryColor">#E8EEF9</Color>
    <Color x:Key="TextSecondaryColor">#A3B3CF</Color>
    <Color x:Key="AccentColor">#4DA3FF</Color>
    <Color x:Key="OnAccentColor">#06121F</Color>

    <!-- Estado de salud (NR-01) -->
    <Color x:Key="StatusNormalColor">#34C759</Color>
    <Color x:Key="StatusWatchColor">#FFB020</Color>
    <Color x:Key="StatusCriticalColor">#FF4D4F</Color>
    <Color x:Key="OnStatusColor">#0B1220</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" po:Freeze="True" />

    <SolidColorBrush x:Key="StatusNormalBrush" Color="{StaticResource StatusNormalColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusWatchBrush" Color="{StaticResource StatusWatchColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="{StaticResource StatusCriticalColor}" po:Freeze="True" />
    <SolidColorBrush x:Key="OnStatusBrush" Color="{StaticResource OnStatusColor}" po:Freeze="True" />

    <!-- Tipografía -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="TitleFontSize">28</sys:Double>

</ResourceDictionary>
