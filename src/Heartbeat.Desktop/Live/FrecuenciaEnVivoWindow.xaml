<Window x:Class="Heartbeat.Desktop.Live.FrecuenciaEnVivoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FC en vivo · Galaxy Watch 5"
        Width="720" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock x:Name="BpmText" Text="--" FontSize="96" FontWeight="Bold"
                       Foreground="{DynamicResource BrandRedBrush}" AutomationProperties.Name="Frecuencia cardíaca" />
            <TextBlock Text="lpm" FontSize="24" Margin="10,0,0,18" VerticalAlignment="Bottom"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="MeasuredText" Text="Sin lecturas todavía" FontSize="15"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="·" Margin="10,0" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock x:Name="StatusText" Text="conectando…" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrandBlueBrush}" />
        </StackPanel>

        <Border Grid.Row="2" x:Name="StaleWarning" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource BrandRedSoftBrush}">
            <TextBlock Text="Sin datos del reloj: abre la app en el reloj y mantén la pantalla encendida"
                       Foreground="{DynamicResource BrandRedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="3" Margin="0,16,0,0" Padding="8" CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged">
                <Polyline x:Name="ChartLine" Stroke="{DynamicResource BrandRedBrush}" StrokeThickness="2"
                          StrokeLineJoin="Round" />
            </Canvas>
        </Border>
    </Grid>
</Window>
