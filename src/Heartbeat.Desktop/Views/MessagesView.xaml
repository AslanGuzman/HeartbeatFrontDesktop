<UserControl x:Class="Heartbeat.Desktop.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MessagesViewModel}"
             Style="{StaticResource PageViewStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Mensajes a control de misión" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Si no hay enlace, el mensaje queda en cola y sale cuando vuelvas a tenerlo."
                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16" />

            <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBox Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="84" VerticalContentAlignment="Top"
                             AutomationProperties.Name="Mensaje para control de misión" />
                    <Button Content="Encolar / enviar" Command="{Binding QueueCommand}" HorizontalAlignment="Right"
                            Margin="0,12,0,0" Padding="20,9" />
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource HoverCardStyle}"
                            Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Todavía no has enviado mensajes." Style="{StaticResource BodyTextStyle}" />
            </ContentControl>

            <ItemsControl ItemsSource="{Binding Messages}" AutomationProperties.Name="Mensajes">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource HoverCardStyle}" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Body}" Style="{StaticResource BodyTextStyle}" />
                                <DockPanel Margin="0,10,0,0">
                                    <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,3" HorizontalAlignment="Right">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BrandRedSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrandBlueSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrandRedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding CreatedText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
