<UserControl x:Class="Heartbeat.Desktop.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             xmlns:svc="clr-namespace:Heartbeat.Desktop.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MessagesViewModel}"
             Style="{StaticResource PageViewStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Mensajes y reportes" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Escribe a control de misión. Si no hay enlace, queda en cola y sale cuando vuelvas a tenerlo."
                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16" />

            <!-- Redactar -->
            <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Mensaje" Style="{StaticResource SegmentButtonStyle}" Margin="0,0,8,0"
                                Command="{Binding ComposeMessageCommand}" Tag="{Binding IsMessageMode}" />
                        <Button Content="Reporte con check-up" Style="{StaticResource SegmentButtonStyle}"
                                Command="{Binding ComposeReportCommand}" Tag="{Binding IsReportMode}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsReportMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                        <TextBlock Text="Check-up que adjuntas" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                        <TextBlock Text="Todavía no tienes check-ups: registra uno para poder adjuntarlo."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{Binding HasCheckUps, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="4"
                                Visibility="{Binding HasCheckUps, Converter={StaticResource BoolToVisibility}}">
                            <ListBox ItemsSource="{Binding CheckUps}" SelectedItem="{Binding SelectedCheckUp, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" MaxHeight="150"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource IndicatorListItemStyle}"
                                     AutomationProperties.Name="Check-ups que se pueden adjuntar">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextStyle}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <TextBlock Text="De este check-up ya enviaste un reporte."
                                   Foreground="{DynamicResource BrandRedBrush}" FontSize="12" Margin="0,6,0,0"
                                   Visibility="{Binding SelectedAlreadyReported, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Text="Asunto (opcional)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                             MaxLength="120" Margin="0,0,0,12" AutomationProperties.Name="Asunto" />

                    <TextBlock Text="Mensaje" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="96" MaxLength="4000" VerticalContentAlignment="Top"
                             AutomationProperties.Name="Mensaje para control de misión" />

                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BrandRedBrush}" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NonEmptyToVisibility}}" />
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Enviar a control de misión" Command="{Binding SendCommand}"
                                Padding="20,9" />
                        <TextBlock Text="{Binding Feedback}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,12,0"
                                   Visibility="{Binding Feedback, Converter={StaticResource NonEmptyToVisibility}}" />
                    </DockPanel>
                </StackPanel>
            </ContentControl>

            <!-- Bandeja / Enviados -->
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Marcar todo como leído" Command="{Binding MarkAllReadCommand}"
                        Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center"
                        Visibility="{Binding IsInboxTab, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding InboxTabText}" Style="{StaticResource SegmentButtonStyle}" Margin="0,0,8,0"
                            Command="{Binding ShowInboxCommand}" Tag="{Binding IsInboxTab}" />
                    <Button Content="Enviados" Style="{StaticResource SegmentButtonStyle}"
                            Command="{Binding ShowSentCommand}" Tag="{Binding IsSentTab}" />
                </StackPanel>
            </DockPanel>

            <!-- Bandeja -->
            <StackPanel Visibility="{Binding IsInboxTab, Converter={StaticResource BoolToVisibility}}">
                <ContentControl Style="{StaticResource HoverCardStyle}"
                                Visibility="{Binding HasInbox, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="No hay respuestas ni alertas reconocidas todavía. Llegan cuando control de misión responde y se sincroniza."
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                </ContentControl>

                <ItemsControl ItemsSource="{Binding Inbox}" AutomationProperties.Name="Bandeja de entrada">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource HoverCardStyle}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="9" Height="9" CornerRadius="5" Margin="0,0,8,0"
                                                VerticalAlignment="Center" Background="{DynamicResource BrandRedBrush}"
                                                Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}" Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeadingStyle}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding From}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,8" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                    <Button Content="Marcar como leído" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding MessageId}"
                                            Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Enviados -->
            <StackPanel Visibility="{Binding IsSentTab, Converter={StaticResource BoolToVisibility}}">
                <ContentControl Style="{StaticResource HoverCardStyle}"
                                Visibility="{Binding HasSent, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Todavía no has enviado mensajes ni reportes." Style="{StaticResource BodyTextStyle}" />
                </ContentControl>

                <ItemsControl ItemsSource="{Binding Sent}" AutomationProperties.Name="Mensajes enviados">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource HoverCardStyle}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeadingStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding ShowBody, Converter={StaticResource BoolToVisibility}}" />
                                    <DockPanel Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,3" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MessageStatus.Sent}">
                                                            <Setter Property="Background" Value="{DynamicResource BrandBlueSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MessageStatus.Read}">
                                                            <Setter Property="Background" Value="{DynamicResource BrandBlueBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MessageStatus.Rejected}">
                                                            <Setter Property="Background" Value="{DynamicResource BrandRedSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MessageStatus.Sent}">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrandBlueBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MessageStatus.Read}">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:MessageStatus.Rejected}">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrandRedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
