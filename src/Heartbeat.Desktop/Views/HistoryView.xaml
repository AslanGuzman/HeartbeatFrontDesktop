<UserControl x:Class="Heartbeat.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             Style="{StaticResource PageViewStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="Historial de check-ups" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Cada check-up guarda sus lecturas (de 1 a 6) con un solo instante." Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,18" />

            <!-- Sin check-ups todavía -->
            <ContentControl Style="{StaticResource HoverCardStyle}"
                            Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Aún no hay check-ups. Registra el primero desde la sección Check-up." Style="{StaticResource BodyTextStyle}" />
            </ContentControl>

            <ItemsControl ItemsSource="{Binding CheckUps}" AutomationProperties.Name="Check-ups registrados">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource CardExpanderStyle}" Margin="0,0,0,10">
                            <Expander.Header>
                                <DockPanel>
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                    <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,3" Margin="10,0,12,0" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SyncText}" ToolTip="{Binding SyncText}" Style="{StaticResource CaptionTextStyle}"
                                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" FontSize="13.5"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Readings}" Margin="8,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Width="170"
                                                       Foreground="{DynamicResource TextBodyBrush}" Margin="10,0,0,0" />
                                            <TextBlock Text="{Binding ValueText}" FontSize="12.5" Width="120" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
