<Window x:Class="Heartbeat.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Heartbeat.Desktop.Views"
        xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="Heartbeat"
        Width="1180" Height="740"
        MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Aviso médico: visible en todas las pantallas, también en el login -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource IconTextStyle}"
                           Text="&#xE946;"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="16"
                           Margin="0,0,10,0" />
                <TextBlock Text="{Binding DisclaimerText}"
                           FontSize="{DynamicResource CaptionFontSize}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="MedicalDisclaimer" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menú lateral: oculto en el login -->
            <Border Grid.Column="0"
                    Width="220"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16"
                    Visibility="{Binding IsNavigationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Heartbeat"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="14,0,0,20" />

                    <Button DockPanel.Dock="Bottom"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding SignOutCommand}"
                            AutomationProperties.Name="Cerrar sesión">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE7E8;" Width="24" Margin="0,0,12,0" />
                            <TextBlock Text="Cerrar sesión" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ItemsControl DockPanel.Dock="Top"
                                  ItemsSource="{Binding NavigationItems}"
                                  IsTabStop="False"
                                  AutomationProperties.Name="Navegación principal">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                                <Button Style="{StaticResource NavItemButtonStyle}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconTextStyle}" Text="{Binding Glyph}" Width="24" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Página actual; la vista se elige en Views/PageTemplates.xaml -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            IsTabStop="False" />
        </Grid>

        <views:StatusBarView Grid.Row="2" DataContext="{Binding StatusBar}" />
    </Grid>
</Window>
