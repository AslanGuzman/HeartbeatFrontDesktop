<UserControl x:Class="Heartbeat.Desktop.Views.CheckUpResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CheckUpResultViewModel}"
             Style="{StaticResource PageViewStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,14,0">

            <!-- Encabezado: estado general en color + texto (NR-01) -->
            <DockPanel Margin="0,0,0,6">
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="14,7" VerticalAlignment="Center"
                        Background="{Binding OverallStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding OverallStatus, Converter={StaticResource StatusToBrush}}" />
                        <TextBlock Text="{Binding OverallText}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{Binding OverallStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Resultado del check-up" Style="{StaticResource TitleTextStyle}" />
            </DockPanel>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,18" />

            <!-- Escalamiento destacado en críticos (MR-06): a quién contactar -->
            <Border Background="{DynamicResource BrandRedBrush}" CornerRadius="16" Padding="20,16" Margin="0,0,0,14"
                    Visibility="{Binding HasEscalation, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconTextStyle}" FontSize="26"
                               Foreground="White" VerticalAlignment="Top" Margin="0,2,16,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Escalation.Title}" FontSize="17" FontWeight="Bold" Foreground="White"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="White" FontSize="14">
                            <Run Text="Contacta a:" FontWeight="SemiBold" />
                            <Run Text="{Binding Escalation.Contact, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock Text="{Binding Escalation.Message}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="White" FontSize="13" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FFE3E3" FontSize="12.5">
                            <Run Text="Indicadores críticos:" FontWeight="SemiBold" />
                            <Run Text="{Binding Escalation.Indicators, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Vigilancia -->
            <Border Background="{DynamicResource BrandBlueSoftBrush}" CornerRadius="14" Padding="16,12" Margin="0,0,0,14"
                    Visibility="{Binding WatchNotice, Converter={StaticResource NonEmptyToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" Style="{StaticResource IconTextStyle}" FontSize="14"
                               Foreground="{DynamicResource BrandBlueBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Text="{Binding WatchNotice}" Foreground="{DynamicResource BrandBlueBrush}" FontSize="12.5"
                               FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="760" />
                </StackPanel>
            </Border>

            <!-- Una tarjeta por lectura: estado y etiqueta con color, y guía si no está en rango (MR-03, MR-04) -->
            <ItemsControl ItemsSource="{Binding Readings}" AutomationProperties.Name="Lecturas del check-up">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DataContext.ShowInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Id}" ToolTip="Por qué importa, cómo medirlo y fuentes"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Información de {0}}" />
                                    <Border DockPanel.Dock="Right" CornerRadius="999" Padding="12,4" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                            <TextBlock Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding ChipText}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ValueText}" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="Dentro del rango de referencia." Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNormal}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Guía: qué hacer ahora -->
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasGuidance, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="QUÉ HACER" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding GuidanceItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="•" Foreground="{DynamicResource BrandBlueBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyTextStyle}" FontSize="13" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Reporte a control de misión -->
            <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,4,0,12">
                <StackPanel>
                    <TextBlock Text="Control de misión" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12"
                               Text="Envía este check-up con su estado y guía a control de misión. Sin enlace queda en cola y sale al reconectar." />
                    <Button Content="Enviar reporte a control de misión" Command="{Binding SendReportCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ReportText}" Margin="0,10,0,0" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrandBlueBrush}" TextWrapping="Wrap"
                               Visibility="{Binding ReportText, Converter={StaticResource NonEmptyToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ContentControl>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Nuevo check-up" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NewCheckUpCommand}" Margin="0,0,10,0" />
                <Button Content="Ver historial" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ShowHistoryCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
