<Window x:Class="Heartbeat.Desktop.Views.IndicatorInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Heartbeat.Desktop.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IndicatorInfoViewModel}"
        Title="{loc:Loc info.windowTitle}"
        Width="900" Height="640"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="{DynamicResource BodyFontSize}"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Lista de indicadores -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top"
                           Text="{loc:Loc info.indicators}"
                           Style="{StaticResource SectionHeadingStyle}"
                           Margin="8,4,8,10" />
                <ListBox ItemsSource="{Binding Indicators}"
                         SelectedItem="{Binding SelectedIndicator, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource IndicatorListItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="{loc:Loc info.listAria}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Unit}" Style="{StaticResource SecondaryTextStyle}" FontSize="{DynamicResource CaptionFontSize}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Ficha del indicador seleccionado -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,24" DataContext="{Binding SelectedIndicator}">
                <TextBlock Text="{Binding Name}" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0">
                    <Run Text="{loc:Loc info.unit}" /><Run Text="{Binding Unit, Mode=OneWay}" /><Run Text="{loc:Loc info.hazard}" /><Run Text="{Binding HazardName, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Text="{loc:Loc info.why}" Style="{StaticResource SectionHeadingStyle}" Margin="0,24,0,6" />
                <TextBlock Text="{Binding WhyItMatters}" TextWrapping="Wrap" LineHeight="21" />

                <TextBlock Text="{loc:Loc info.how}" Style="{StaticResource SectionHeadingStyle}" Margin="0,24,0,6" />
                <ItemsControl ItemsSource="{Binding HowToMeasure}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:Loc info.risks}" Style="{StaticResource SectionHeadingStyle}" Margin="0,24,0,6" />
                <TextBlock Text="{Binding Risks}" TextWrapping="Wrap" LineHeight="21" />

                <TextBlock Text="{loc:Loc info.sources}" Style="{StaticResource SectionHeadingStyle}" Margin="0,24,0,2" />
                <TextBlock Text="{loc:Loc info.linksHint}" Style="{StaticResource SecondaryTextStyle}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Sources}"
                              AutomationProperties.Name="{loc:Loc info.sourcesAria}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Url.AbsoluteUri}"
                                    AutomationProperties.Name="{Binding Title}"
                                    AutomationProperties.HelpText="{Binding Url.AbsoluteUri}">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextDecorations="Underline" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Cuando el sistema no abre el enlace se muestra la dirección para copiarla. No usa colores de estado de salud (NR-01). -->
                <Border Visibility="{Binding DataContext.HasLinkError, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,12,0,0">
                    <TextBlock Text="{Binding DataContext.LinkErrorText, RelativeSource={RelativeSource AncestorType=Window}}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Aviso médico y versión de los rangos -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding DisclaimerText}" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding RangesVersionText}" Style="{StaticResource SecondaryTextStyle}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
