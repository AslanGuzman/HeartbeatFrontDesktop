<UserControl x:Class="Heartbeat.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
             Style="{StaticResource PageViewStyle}"
             Loaded="OnLoaded">

    <!-- Tarjeta dividida: panel de marca azul + formulario -->
    <Border Width="880" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center"
            Background="{DynamicResource SurfaceBrush}" CornerRadius="22"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#110559" BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.10" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- Panel de marca -->
            <Border Grid.Column="0" CornerRadius="22,0,0,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#110559" Offset="0" />
                        <GradientStop Color="#1C0F7E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" Margin="36,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB52;" Style="{StaticResource IconTextStyle}" FontSize="26" Foreground="White" />
                        <TextBlock Text="Heartbeat" FontSize="26" FontWeight="Bold" Foreground="White"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Tu salud, incluso sin señal." Foreground="#C9C5EE" FontSize="14"
                               Margin="0,10,0,26" TextWrapping="Wrap" />

                    <!-- Línea de ECG que se dibuja en bucle (decorativa) -->
                    <Polyline Points="0,30 35,30 48,30 58,6 68,52 78,18 86,30 120,30 150,30 163,8 173,50 183,22 191,30 240,30"
                              Stroke="#FF8A8A" StrokeThickness="2.5" StrokeLineJoin="Round"
                              Stretch="Uniform" Height="64"
                              StrokeDashArray="260" StrokeDashOffset="260">
                        <Polyline.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                         From="260" To="-260" Duration="0:0:4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Polyline.Triggers>
                    </Polyline>

                    <TextBlock Text="Registra, evalúa y actúa sobre tus indicadores de salud, con o sin enlace con la Tierra."
                               Foreground="#B4AFE0" FontSize="12.5" Margin="0,26,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Formulario -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="48,0">
                <TextBlock Text="Bienvenido de vuelta" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,26" />

                <TextBlock Text="USUARIO" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}" Margin="0,6,0,16"
                         AutomationProperties.Name="Usuario" />

                <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox x:Name="PassBox" Style="{StaticResource PasswordInputStyle}" Margin="0,6,0,24"
                             AutomationProperties.Name="Contraseña" />

                <Button Content="Entrar" Click="SignIn_Click" IsDefault="True" HorizontalAlignment="Stretch" />

                <Border Background="{DynamicResource BrandRedSoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,14,0,0"
                        Visibility="{Binding Error, Converter={StaticResource NonEmptyToVisibility}}">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BrandRedBrush}"
                               FontSize="12.5" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <TextBlock Text="{Binding DemoHint}" Style="{StaticResource CaptionTextStyle}"
                           Margin="0,20,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
