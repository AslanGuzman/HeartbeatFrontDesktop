<UserControl x:Class="Heartbeat.Desktop.Views.CheckUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             xmlns:views="clr-namespace:Heartbeat.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CheckUpViewModel}"
             Style="{StaticResource PageViewStyle}">

    <UserControl.Resources>
        <!-- Botón «i» de cada campo: abre la información del indicador sin salir del formulario -->
        <Style x:Key="FieldInfoButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Command" Value="{Binding ShowInfoCommand}" />
            <Setter Property="ToolTip" Value="Por qué importa, cómo medirlo y fuentes" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1200" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="500" />
            </Grid.ColumnDefinitions>

            <!-- Formulario y resultado de la evaluación -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top">
            <!-- Formulario -->
            <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Check-up de rutina" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,18"
                               Text="Registra de 1 a 6 indicadores en una sola sesión; deja en blanco los que no midas hoy. Se evalúan en tu equipo aunque no haya enlace." />

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource FieldInfoButton}"
                                        CommandParameter="bloodPressure" AutomationProperties.Name="Información de presión arterial" />
                                <TextBlock Text="PRESIÓN SISTÓLICA · mmHg" Style="{StaticResource FieldLabelStyle}" />
                            </DockPanel>
                            <TextBox Text="{Binding Systolic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                     Margin="0,4,0,0" AutomationProperties.Name="Presión sistólica en mmHg" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource FieldInfoButton}"
                                        CommandParameter="bloodPressure" AutomationProperties.Name="Información de presión arterial" />
                                <TextBlock Text="PRESIÓN DIASTÓLICA · mmHg" Style="{StaticResource FieldLabelStyle}" />
                            </DockPanel>
                            <TextBox Text="{Binding Diastolic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                     Margin="0,4,0,0" AutomationProperties.Name="Presión diastólica en mmHg" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource FieldInfoButton}"
                                        CommandParameter="heartRate" AutomationProperties.Name="Información de frecuencia cardíaca" />
                                <TextBlock Text="FRECUENCIA CARDÍACA · lpm" Style="{StaticResource FieldLabelStyle}" />
                            </DockPanel>
                            <TextBox Text="{Binding HeartRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                     Margin="0,4,0,0" AutomationProperties.Name="Frecuencia cardíaca en latidos por minuto" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource FieldInfoButton}"
                                        CommandParameter="bloodSugar" AutomationProperties.Name="Información de glucosa" />
                                <TextBlock Text="GLUCOSA · mg/dL" Style="{StaticResource FieldLabelStyle}" />
                            </DockPanel>
                            <TextBox Text="{Binding BloodSugar, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                     Margin="0,4,0,0" AutomationProperties.Name="Glucosa en mg/dL" />
                        </StackPanel>

                        <StackPanel Margin="0,0,12,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource FieldInfoButton}"
                                        CommandParameter="bodyTemperature" AutomationProperties.Name="Información de temperatura corporal" />
                                <TextBlock Text="TEMPERATURA · °C" Style="{StaticResource FieldLabelStyle}" />
                            </DockPanel>
                            <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                     Margin="0,4,0,0" AutomationProperties.Name="Temperatura corporal en grados Celsius" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource FieldInfoButton}"
                                        CommandParameter="sleep" AutomationProperties.Name="Información de sueño" />
                                <TextBlock Text="SUEÑO · horas/día" Style="{StaticResource FieldLabelStyle}" />
                            </DockPanel>
                            <TextBox Text="{Binding SleepHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                     Margin="0,4,0,0" AutomationProperties.Name="Horas de sueño al día" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Sueño también con deslizador (paso de 0,5 h); sigue al campo de texto y viceversa -->
                    <DockPanel Margin="0,-4,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SleepSlider, StringFormat={}{0:0.#} h}" FontSize="12"
                                   Visibility="{Binding SleepHours, Converter={StaticResource NonEmptyToVisibility}}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrandBlueBrush}" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider Minimum="0" Maximum="24" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1"
                                Value="{Binding SleepSlider}" Style="{StaticResource MoodSliderStyle}" VerticalAlignment="Center"
                                AutomationProperties.Name="Horas de sueño con deslizador, de 0 a 24 en pasos de media hora" />
                    </DockPanel>

                    <DockPanel Margin="0,2,0,8">
                        <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource FieldInfoButton}"
                                CommandParameter="mood" AutomationProperties.Name="Información de estado de ánimo" />
                        <TextBlock Text="ESTADO DE ÁNIMO · opcional (vuelve a pulsar para quitarlo)" Style="{StaticResource FieldLabelStyle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding MoodOptions}" AutomationProperties.Name="Estado de ánimo">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChoiceButtonStyle}" Margin="0,0,8,0"
                                        Command="{Binding DataContext.SelectMoodCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Value}"
                                        AutomationProperties.Name="{Binding Label, StringFormat=Estado de ánimo: {0}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="NOTA · opcional" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,4" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                             MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top"
                             AutomationProperties.Name="Nota opcional del check-up, hasta 500 caracteres" />

                    <Button Content="Guardar check-up" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Margin="0,20,0,0" />

                    <Border Background="{DynamicResource BrandRedSoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding Error, Converter={StaticResource NonEmptyToVisibility}}">
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BrandRedBrush}" FontSize="12.5"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                </StackPanel>
            </ContentControl>

            <!-- Resultado de la evaluación -->
            <StackPanel>

                <!-- Escalamiento en críticos (MR-06) -->
                <Border Background="{DynamicResource BrandRedBrush}" CornerRadius="14" Padding="16,12" Margin="0,0,0,14"
                        Visibility="{Binding Escalation, Converter={StaticResource NonEmptyToVisibility}}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource IconTextStyle}" FontSize="18" Foreground="White"
                                   VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Text="{Binding Escalation}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>

                <!-- Confirmación -->
                <Border Background="{DynamicResource BrandBlueSoftBrush}" CornerRadius="14" Padding="16,12" Margin="0,0,0,14"
                        Visibility="{Binding SavedText, Converter={StaticResource NonEmptyToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconTextStyle}" FontSize="14"
                                   Foreground="{DynamicResource BrandBlueBrush}" />
                        <TextBlock Text="{Binding SavedText}" Foreground="{DynamicResource BrandBlueBrush}" FontSize="12.5"
                                   FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Results}" AutomationProperties.Name="Resultado del check-up">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource HoverCardStyle}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,3" VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ValueText}" FontSize="13" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Guidance}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                                </StackPanel>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </StackPanel>

            <!-- Medidas corporales -->
            <views:BodyPanelView Grid.Column="1" DataContext="{Binding Body}" VerticalAlignment="Top" />
        </Grid>
    </ScrollViewer>
</UserControl>
