<UserControl x:Class="Heartbeat.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Style="{StaticResource PageViewStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Encabezado: saludo, estado general y botón de nuevo check-up -->
            <DockPanel Margin="0,0,14,6">
                <Button DockPanel.Dock="Right" Command="{Binding NewCheckUpCommand}" VerticalAlignment="Center"
                        AutomationProperties.Name="Nuevo check-up">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconTextStyle}" FontSize="13" Foreground="White" Margin="0,0,8,0" />
                        <TextBlock Text="Nuevo check-up" />
                    </StackPanel>
                </Button>
                <!-- Estado general: color + texto (NR-01) -->
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="14,8" Margin="0,0,14,0" VerticalAlignment="Center"
                        Background="{Binding OverallStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding OverallStatus, Converter={StaticResource StatusToBrush}}" />
                        <TextBlock Text="{Binding OverallText}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{Binding OverallStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}"
                                   AutomationProperties.AutomationId="OverallStatus" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryTextStyle}" FontSize="13" Margin="0,0,14,16"
                       AutomationProperties.AutomationId="Summary" />

            <!-- Aviso destacado cuando hay indicadores críticos (MR-06) -->
            <Border Background="{DynamicResource BrandRedBrush}" CornerRadius="14" Padding="18,12" Margin="0,0,14,16"
                    Visibility="{Binding HasCritical, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconTextStyle}" FontSize="20"
                               Foreground="White" VerticalAlignment="Top" Margin="0,1,14,0" />
                    <StackPanel>
                        <TextBlock Text="Hay indicadores críticos: avisa a tu oficial médico de la tripulación" FontSize="14"
                                   FontWeight="Bold" Foreground="White" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="#FFE3E3" TextWrapping="Wrap">
                            <Run Text="Críticos:" FontWeight="SemiBold" /> <Run Text="{Binding CriticalNames, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Los seis indicadores en una pantalla (MR-05) -->
            <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.Name="Indicadores de salud">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource HoverCardStyle}" Width="310" Margin="0,0,14,14">
                            <StackPanel>
                                <DockPanel>
                                    <!-- «i»: abre el panel de información de este indicador -->
                                    <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DataContext.ShowInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip="Por qué importa, cómo medirlo y fuentes"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Información de {0}}" />
                                    <Border Width="40" Height="40" CornerRadius="12"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconTextStyle}" FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeadingStyle}"
                                               Margin="12,0,8,0" VerticalAlignment="Center" />
                                </DockPanel>

                                <DockPanel Margin="0,14,0,0">
                                    <!-- Chip de estado: color + texto (NR-01) -->
                                    <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,4" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding ValueText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding UnitText}" FontSize="13" Margin="6,0,0,4" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding TakenAtText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />

                                <!-- Onda decorativa teñida por estado -->
                                <Path Data="M0,26 C30,4 55,40 90,16 C115,0 135,30 160,14 L160,40 L0,40 Z"
                                      Stretch="Fill" Height="30" Margin="0,10,0,0" Opacity="0.14"
                                      Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />

                                <!-- Guía por estado (MR-04) -->
                                <TextBlock Text="{Binding Guidance}" Style="{StaticResource BodyTextStyle}" FontSize="13" Margin="0,10,0,0" />
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fuentes y referencias de todos los indicadores -->
            <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,4,14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                            Content="Ver todas las fuentes y referencias" Command="{Binding ShowInfoCommand}" />
                    <StackPanel>
                        <TextBlock Text="Información de los indicadores" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,12,0"
                                   Text="Por qué importa cada medición, cómo hacerla y sus riesgos, con las fuentes de NASA y de otras agencias." />
                    </StackPanel>
                </DockPanel>
            </ContentControl>

            <!-- Tendencias: espacio reservado -->
            <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,0,14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE9D2;" Style="{StaticResource IconTextStyle}" FontSize="34"
                               Foreground="{DynamicResource BrandBlueSoftBrush}" Margin="12,0,6,0" />
                    <StackPanel>
                        <TextBlock Text="Tendencias" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                                   Text="Próximamente: la evolución de cada indicador en el tiempo. En misiones largas la tendencia importa más que una lectura suelta." />
                    </StackPanel>
                </DockPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
