<UserControl x:Class="Heartbeat.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Style="{StaticResource PageViewStyle}">

    <UserControl.Resources>
        <!-- Región clicable de la figura: el relleno es el color del peor estado de la región (NR-01, NR-04) -->
        <Style x:Key="BodyRegionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Path x:Name="Shape" Data="{Binding Geometry}" StrokeThickness="2" StrokeLineJoin="Round" Opacity="0.82"
                              Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                              Stroke="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shape" Property="Opacity" Value="1" />
                                <Setter TargetName="Shape" Property="StrokeThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shape" Property="Opacity" Value="1" />
                                <Setter TargetName="Shape" Property="Stroke" Value="{DynamicResource BrandBlueBrush}" />
                                <Setter TargetName="Shape" Property="StrokeThickness" Value="3.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Encabezado: saludo, estado general y botón de nuevo check-up -->
            <DockPanel Margin="0,0,14,6">
                <Button DockPanel.Dock="Right" Command="{Binding NewCheckUpCommand}" VerticalAlignment="Center"
                        AutomationProperties.Name="Nuevo check-up">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconTextStyle}" FontSize="13" Foreground="White" Margin="0,0,8,0" />
                        <TextBlock Text="Nuevo check-up" />
                    </StackPanel>
                </Button>
                <!-- Estado general: color + texto (NR-01) -->
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="14,8" Margin="0,0,14,0" VerticalAlignment="Center"
                        Background="{Binding OverallStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding OverallStatus, Converter={StaticResource StatusToBrush}}" />
                        <TextBlock Text="{Binding OverallText}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{Binding OverallStatus, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}"
                                   AutomationProperties.AutomationId="OverallStatus" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryTextStyle}" FontSize="13" Margin="0,0,14,16"
                       AutomationProperties.AutomationId="Summary" />

            <!-- Aviso destacado cuando hay indicadores críticos (MR-06) -->
            <Border Background="{DynamicResource BrandRedBrush}" CornerRadius="14" Padding="18,12" Margin="0,0,14,16"
                    Visibility="{Binding HasCritical, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource IconTextStyle}" FontSize="20"
                               Foreground="White" VerticalAlignment="Top" Margin="0,1,14,0" />
                    <StackPanel>
                        <TextBlock Text="Hay indicadores críticos: avisa a tu oficial médico de la tripulación" FontSize="14"
                                   FontWeight="Bold" Foreground="White" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="#FFE3E3" TextWrapping="Wrap">
                            <Run Text="Críticos:" FontWeight="SemiBold" /> <Run Text="{Binding CriticalNames, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Check-up de rutina de hoy pendiente (P2-REMIND) -->
            <Border Background="{DynamicResource BrandBlueSoftBrush}" CornerRadius="14" Padding="18,12" Margin="0,0,14,16"
                    Visibility="{Binding IsCheckUpPending, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Registrar check-up" Command="{Binding NewCheckUpCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Text="&#xE823;" Style="{StaticResource IconTextStyle}" FontSize="20"
                               Foreground="{DynamicResource BrandBlueBrush}" VerticalAlignment="Top" Margin="0,1,14,0" />
                    <StackPanel>
                        <TextBlock Text="Check-up de hoy pendiente" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource BrandBlueBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding PendingCheckUpText}" Margin="0,4,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource TextBodyBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Los seis indicadores en una pantalla (MR-05) -->
            <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.Name="Indicadores de salud">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource HoverCardStyle}" Width="310" Margin="0,0,14,14">
                            <StackPanel>
                                <DockPanel>
                                    <!-- «i»: abre el panel de información de este indicador -->
                                    <Button DockPanel.Dock="Right" Content="&#xE946;" Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DataContext.ShowInfoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip="Por qué importa, cómo medirlo y fuentes"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Información de {0}}" />
                                    <Border Width="40" Height="40" CornerRadius="12"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconTextStyle}" FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeadingStyle}"
                                               Margin="12,0,8,0" VerticalAlignment="Center" />
                                </DockPanel>

                                <DockPanel Margin="0,14,0,0">
                                    <!-- Chip de estado: color + texto (NR-01) -->
                                    <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,4" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding ValueText}" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding UnitText}" FontSize="13" Margin="6,0,0,4" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding TakenAtText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />

                                <!-- Onda decorativa teñida por estado -->
                                <Path Data="M0,26 C30,4 55,40 90,16 C115,0 135,30 160,14 L160,40 L0,40 Z"
                                      Stretch="Fill" Height="30" Margin="0,10,0,0" Opacity="0.14"
                                      Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />

                                <!-- Guía por estado (MR-04) -->
                                <TextBlock Text="{Binding Guidance}" Style="{StaticResource BodyTextStyle}" FontSize="13" Margin="0,10,0,0" />
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Figura humana: cada región con el peor estado de sus indicadores; clic abre su información (NR-04) -->
            <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,4,14,14">
                <StackPanel>
                    <TextBlock Text="Mapa del cuerpo" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,14" TextWrapping="Wrap"
                               Text="Cada región toma el color del peor estado de sus indicadores. Haz clic en una región para ver por qué importa y cómo medirla." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="156" Height="429" VerticalAlignment="Top" HorizontalAlignment="Left" Stretch="Uniform">
                        <Grid Width="120" Height="330" AutomationProperties.Name="Figura del cuerpo con el estado de cada región">
                            <!-- Silueta -->
                            <Rectangle Width="16" Height="14" Margin="0,54,0,0" VerticalAlignment="Top" Fill="{DynamicResource SurfaceRaisedBrush}" />
                            <Path Fill="{DynamicResource SurfaceRaisedBrush}" Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1"
                                  Data="M40,66 C26,68 20,76 18,92 L12,152 L23,154 L30,108 L34,170 L36,200 L84,200 L86,170 L90,108 L97,154 L108,152 L102,92 C100,76 94,68 80,66 Z" />
                            <Path Fill="{DynamicResource SurfaceRaisedBrush}" Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1"
                                  Data="M38,200 L36,300 L35,320 L55,320 L57,300 L60,236 L63,300 L65,320 L85,320 L84,300 L82,200 Z" />

                            <!-- Regiones clicables -->
                            <ItemsControl ItemsSource="{Binding Regions}" IsTabStop="False" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BodyRegionButtonStyle}"
                                                Command="{Binding DataContext.ShowRegionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip="{Binding SummaryText}"
                                                AutomationProperties.Name="{Binding SummaryText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        </Viewbox>

                        <!-- Detalle por región: el estado también en texto, no solo en color -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Regions}" AutomationProperties.Name="Estado por región">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="999" Padding="10,3" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Soft}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=Text}" />
                                            </Border>
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeadingStyle}" Margin="8,0,0,0" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Indicators}" Margin="18,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,1"
                                                            Command="{Binding DataContext.ShowInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Información de {0}}">
                                                        <TextBlock FontSize="12.5">
                                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ValueText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <!-- Fuentes y referencias de todos los indicadores -->
            <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,4,14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                            Content="Ver todas las fuentes y referencias" Command="{Binding ShowInfoCommand}" />
                    <StackPanel>
                        <TextBlock Text="Información de los indicadores" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,12,0"
                                   Text="Por qué importa cada medición, cómo hacerla y sus riesgos, con las fuentes de NASA y de otras agencias." />
                    </StackPanel>
                </DockPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
