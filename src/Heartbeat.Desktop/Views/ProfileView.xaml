<UserControl x:Class="Heartbeat.Desktop.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Heartbeat.Desktop.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel}"
             Style="{StaticResource PageViewStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,14,0">
            <TextBlock Text="{loc:Loc profile.heading}" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,18"
                       Text="{loc:Loc profile.intro}" />

            <!-- Sin perfil guardado -->
            <ContentControl Style="{StaticResource HoverCardStyle}"
                            Visibility="{Binding HasProfile, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Style="{StaticResource BodyTextStyle}"
                           Text="{loc:Loc profile.none}" />
            </ContentControl>

            <Grid Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- Datos editables -->
                <ContentControl Grid.Column="0" Style="{StaticResource HoverCardStyle}" Margin="0,0,16,14" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc profile.editable}" Style="{StaticResource SectionHeadingStyle}" />

                        <TextBlock Text="{loc:Loc profile.nameLabel}" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,4" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                 MaxLength="100" AutomationProperties.Name="{loc:Loc profile.nameAria}"
                                 AutomationProperties.HelpText="{loc:Loc profile.nameHelp}" />
                        <TextBlock Text="{Binding DisplayNameError}" Foreground="{DynamicResource BrandRedBrush}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding DisplayNameError, Converter={StaticResource NonEmptyToVisibility}}"
                                   AutomationProperties.LiveSetting="Polite" />

                        <TextBlock Text="{loc:Loc profile.callSignLabel}" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4" />
                        <TextBox Text="{Binding CallSign, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                 MaxLength="30" AutomationProperties.Name="{loc:Loc profile.callSignAria}"
                                 AutomationProperties.HelpText="{loc:Loc profile.callSignHelp}" />
                        <TextBlock Text="{Binding CallSignError}" Foreground="{DynamicResource BrandRedBrush}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding CallSignError, Converter={StaticResource NonEmptyToVisibility}}" />

                        <DockPanel Margin="0,14,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding NotesCounterText}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{loc:Loc profile.notesLabel}" Style="{StaticResource FieldLabelStyle}" />
                        </DockPanel>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                 MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalContentAlignment="Top"
                                 AutomationProperties.Name="{loc:Loc profile.notesAria}" AutomationProperties.HelpText="{loc:Loc profile.notesHelp}" />
                        <TextBlock Text="{Binding NotesError}" Foreground="{DynamicResource BrandRedBrush}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding NotesError, Converter={StaticResource NonEmptyToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="{loc:Loc profile.save}" Command="{Binding SaveCommand}" Margin="0,0,10,0" />
                            <Button Content="{loc:Loc profile.discard}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DiscardCommand}" />
                        </StackPanel>

                        <Border Background="{DynamicResource BrandRedSoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,12,0,0"
                                Visibility="{Binding Error, Converter={StaticResource NonEmptyToVisibility}}">
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BrandRedBrush}" FontSize="12.5"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        </Border>
                        <TextBlock Text="{Binding SavedText}" Foreground="{DynamicResource BrandBlueBrush}" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="0,12,0,0" Visibility="{Binding SavedText, Converter={StaticResource NonEmptyToVisibility}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ContentControl>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <!-- Estado de sincronización del perfil -->
                    <Border CornerRadius="16" Padding="18,14" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BrandBlueSoftBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingEdit}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrandBlueBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding SyncText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrandBlueBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingEdit}" Value="True">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdatedText}" FontSize="12" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingEdit}" Value="True">
                                                <Setter Property="Foreground" Value="#D8D4F5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Datos que no se editan -->
                    <ContentControl Style="{StaticResource HoverCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc profile.account}" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="{loc:Loc login.userLabel}" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,2" />
                            <TextBlock Text="{Binding UserName}" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="{loc:Loc profile.missionLabel}" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                            <TextBlock Text="{Binding MissionText}" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock Text="{Binding MissionDayText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                            <StackPanel Visibility="{Binding DateOfBirthText, Converter={StaticResource NonEmptyToVisibility}}">
                                <TextBlock Text="{loc:Loc profile.birthLabel}" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                                <TextBlock Text="{Binding DateOfBirthText}" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,14,0,0"
                                       Text="{loc:Loc profile.managed}" />
                        </StackPanel>
                    </ContentControl>

                    <!-- Recordatorio diario de check-up (P2-REMIND) -->
                    <ContentControl Style="{StaticResource HoverCardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Recordatorio de check-up" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap"
                                       Text="Elige cuándo quieres que Windows te avise si aún no has registrado el check-up del día." />
                            <CheckBox Content="Avisarme todos los días" IsChecked="{Binding ReminderEnabled}"
                                      Foreground="{DynamicResource TextBodyBrush}"
                                      AutomationProperties.Name="Recordatorio diario de check-up" />
                            <TextBlock Text="HORA · HH:MM" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding ReminderTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"
                                     MaxLength="5" AutomationProperties.Name="Hora del recordatorio"
                                     AutomationProperties.HelpText="Formato HH:mm, por ejemplo 09:00" />
                            <TextBlock Text="{Binding ReminderError}" Foreground="{DynamicResource BrandRedBrush}" FontSize="12" Margin="0,4,0,0"
                                       Visibility="{Binding ReminderError, Converter={StaticResource NonEmptyToVisibility}}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button Content="Guardar recordatorio" Command="{Binding SaveReminderCommand}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding ReminderSavedText}" Foreground="{DynamicResource BrandBlueBrush}" FontSize="12.5"
                                       FontWeight="SemiBold" Margin="0,10,0,0"
                                       Visibility="{Binding ReminderSavedText, Converter={StaticResource NonEmptyToVisibility}}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
