<UserControl x:Class="Heartbeat.Desktop.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Heartbeat.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StatusBarViewModel}"
             IsTabStop="False">

    <!-- Estado de conexión, último sync y pendientes. El contenedor (pie de la ventana) pone el fondo. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Segoe MDL2 Assets: E839 = conectado, EB5E = sin conexión -->
        <TextBlock FontSize="{DynamicResource CaptionFontSize}" Margin="0,0,8,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                    <Setter Property="Text" Value="&#xEB5E;" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                            <Setter Property="Text" Value="&#xE839;" />
                            <Setter Property="Foreground" Value="{DynamicResource BrandBlueBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding ConnectionText}"
                   FontSize="{DynamicResource CaptionFontSize}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="ConnectionState" />

        <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="14,0" />

        <TextBlock Text="{Binding LastSyncText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="{DynamicResource CaptionFontSize}"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="LastSync" />

        <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="14,0" />

        <!-- Los pendientes se resaltan con una píldora de marca: el verde/ámbar queda reservado al estado de salud (NR-01) -->
        <Border CornerRadius="999" Padding="10,2" VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPending}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandBlueSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding PendingText}"
                       FontSize="{DynamicResource CaptionFontSize}"
                       AutomationProperties.AutomationId="PendingCount">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPending}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BrandBlueBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Elementos que el servidor rechazó: se ven con su motivo en el historial y en Mensajes -->
        <Border CornerRadius="999" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource BrandRedSoftBrush}"
                Visibility="{Binding HasRejected, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding RejectedText}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrandRedBrush}" AutomationProperties.AutomationId="RejectedCount" />
        </Border>

        <!-- Estado de la sincronización y envío manual -->
        <TextBlock Text="{Binding SyncStateText}" FontSize="{DynamicResource CaptionFontSize}" Margin="14,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360"
                   Visibility="{Binding HasSyncState, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.AutomationId="SyncState" AutomationProperties.LiveSetting="Polite" />
        <Button Content="Sincronizar ahora" Command="{Binding SyncNowCommand}" Style="{StaticResource LinkButtonStyle}"
                FontSize="{DynamicResource CaptionFontSize}" Margin="14,0,0,0" Padding="2,0" VerticalAlignment="Center"
                AutomationProperties.Name="Sincronizar ahora" />
    </StackPanel>
</UserControl>
